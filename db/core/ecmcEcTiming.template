# EtherCAT endpoint timing diagnostics using the normal slave PV prefix.

record(longin, "${ECMC_P}Timing-$(DIR_PV)-Stat") {
  field(DESC, "Timing status bits")
  field(DTYP, "asynInt32")
  field(INP,  "@asyn($(TIMING_PORT=ecmcRTLog),$(SLAVE_POS),$(TIMEOUT=1))timing.$(DIR_ASYN).status")
  field(SCAN, "I/O Intr")
  field(TSE,  "$(TSE=-2)")
  field(FLNK, "${ECMC_P}Timing-$(DIR_PV)-Stat_.PROC")
}

record(mbbiDirect, "${ECMC_P}Timing-$(DIR_PV)-Stat_") {
  field(DESC, "Timing status bits")
  field(INP,  "${ECMC_P}Timing-$(DIR_PV)-Stat.VAL")
  field(FLNK, "${ECMC_P}Timing-$(DIR_PV)-Valid.PROC")
}

record(bi, "${ECMC_P}Timing-$(DIR_PV)-Valid") {
  field(DESC, "Timing is usable")
  field(INP,  "${ECMC_P}Timing-$(DIR_PV)-Stat_.B0")
  field(ZNAM, "Invalid")
  field(ONAM, "Valid")
  field(FLNK, "${ECMC_P}Timing-$(DIR_PV)-DC.PROC")
}

record(bi, "${ECMC_P}Timing-$(DIR_PV)-DC") {
  field(DESC, "DC configured")
  field(INP,  "${ECMC_P}Timing-$(DIR_PV)-Stat_.B1")
  field(ZNAM, "No DC")
  field(ONAM, "DC")
  field(FLNK, "${ECMC_P}Timing-$(DIR_PV)-Discovery.PROC")
}

record(bi, "${ECMC_P}Timing-$(DIR_PV)-Discovery") {
  field(DESC, "Timing discovery done")
  field(INP,  "${ECMC_P}Timing-$(DIR_PV)-Stat_.B2")
  field(ZNAM, "Pending/N/A")
  field(ONAM, "Complete")
  field(FLNK, "${ECMC_P}Timing-$(DIR_PV)-Override.PROC")
}

record(bi, "${ECMC_P}Timing-$(DIR_PV)-Override") {
  field(DESC, "Timing override used")
  field(INP,  "${ECMC_P}Timing-$(DIR_PV)-Stat_.B3")
  field(FLNK, "${ECMC_P}Timing-$(DIR_PV)-Timestamp.PROC")
}

record(bi, "${ECMC_P}Timing-$(DIR_PV)-Timestamp") {
  field(DESC, "Timestamp linked")
  field(INP,  "${ECMC_P}Timing-$(DIR_PV)-Stat_.B4")
  field(FLNK, "${ECMC_P}Timing-$(DIR_PV)-CalcCopyValid.PROC")
}

record(bi, "${ECMC_P}Timing-$(DIR_PV)-CalcCopyValid") {
  field(DESC, "Calc/copy time valid")
