record(mbbi, "${ECMC_P}Timing-$(DIR_PV)-Source") {
  field(DESC, "Timing source")
  field(DTYP, "asynInt32")
  field(INP,  "@asyn($(TIMING_PORT=ecmcRTLog),$(SLAVE_POS),$(TIMEOUT=1))timing.$(DIR_ASYN).source")
  field(SCAN, "I/O Intr")
  field(ZRST, "Cycle only")
  field(ZRVL, "0")
  field(ONST, "SYNC0")
  field(ONVL, "1")
  field(TWST, "SYNC1")
  field(TWVL, "2")
  field(THST, "Timestamp")
  field(THVL, "3")
}

