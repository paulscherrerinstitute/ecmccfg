# Optional position-compare readbacks for one axis.
# Loaded only when the axis YAML contains a positionCompare section.

record(mbbi,"${P}${AXIS_NAME}-PC-State"){
  field(PINI, "1")
  field(DTYP, "asynInt32")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt32/ax$(AXIS_NO).poscomp.state?")
  field(SCAN, "I/O Intr")
  field(DESC, "Position compare state")
  field(TSE,  "$(TSE=-2)")
  field(ZRST, "DISABLED")
  field(ZRVL, "0")
  field(ONST, "ARMED")
  field(ONVL, "1")
  field(TWST, "QUEUED")
  field(TWVL, "2")
  field(THST, "FIRED")
  field(THVL, "3")
  field(FRST, "MISSED")
  field(FRVL, "4")
  field(FVST, "ERROR")
  field(FVVL, "5")
  field(SXST, "RESET_QUEUED")
  field(SXVL, "6")
}

record(mbbi,"${P}${AXIS_NAME}-PC-Reason"){
  field(PINI, "1")
  field(DTYP, "asynInt32")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt32/ax$(AXIS_NO).poscomp.reason?")
  field(SCAN, "I/O Intr")
  field(DESC, "Position compare reason")
  field(TSE,  "$(TSE=-2)")
  field(ZRST, "NONE")
  field(ZRVL, "0")
  field(ONST, "ARMED")
  field(ONVL, "1")
  field(TWST, "IDLE_CYCLE")
  field(TWVL, "2")
  field(THST, "WAIT_DIR")
  field(THVL, "3")
  field(FRST, "WAIT_VEL")
  field(FRVL, "4")
  field(FVST, "TOO_FAR")
  field(FVVL, "5")
  field(SXST, "TOO_LATE")
  field(SXVL, "6")
  field(SVST, "TOO_CLOSE")
  field(SVVL, "7")
  field(EIST, "SCHED_OUT")
  field(EIVL, "8")
  field(NIST, "SCHED_RESET")
  field(NIVL, "9")
  field(TEST, "FIRED")
  field(TEVL, "10")
  field(ELST, "RESET_DONE")
  field(ELVL, "11")
  field(TVST, "ERROR")
  field(TVVL, "12")
  field(TTST, "MISSED")
  field(TTVL, "13")
}

