  field(PINI, "1")
  field(DTYP, "asynInt64")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt64/ax$(AXIS_NO).poscomp.sequence?")
  field(SCAN, "I/O Intr")
  field(DESC, "Position compare sequence")
  field(TSE,  "$(TSE=-2)")
}

record(ai,"${P}${AXIS_NAME}-PC-Target"){
  field(PINI, "1")
  field(DTYP, "asynFloat64")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynFloat64/ax$(AXIS_NO).poscomp.target?")
  field(PREC, "${PREC=3}")
  field(EGU,  "${EGU=mm}")
  field(SCAN, "I/O Intr")
  field(DESC, "Position compare target")
  field(TSE,  "$(TSE=-2)")
}

