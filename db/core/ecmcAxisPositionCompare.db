record(ao,"${P}${AXIS_NAME}-PC-TargetCmd"){
  info(asyn:READBACK,"1")
  field(DESC, "Position compare target")
  field(DTYP, "asynFloat64")
  field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynFloat64/ax$(AXIS_NO).poscomp.targetcmd?")
  field(PREC, "${PREC=3}")
  field(EGU,  "${EGU=mm}")
  field(SCAN, "Passive")
}

record(longout,"${P}${AXIS_NAME}-PC-DirCmd"){
  info(asyn:READBACK,"1")
  field(DESC, "Position compare direction")
  field(DTYP, "asynInt32")
  field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt32/ax$(AXIS_NO).poscomp.directioncmd?")
  field(DRVL, "-1")
  field(DRVH, "1")
  field(SCAN, "Passive")
}

record(int64out,"${P}${AXIS_NAME}-PC-OutputCmd"){
  info(asyn:READBACK,"1")
  field(DESC, "Position compare output")
  field(DTYP, "asynInt64")
  field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt64/ax$(AXIS_NO).poscomp.outputcmd?")
  field(VAL,  "1")
  field(SCAN, "Passive")
}

record(bo,"${P}${AXIS_NAME}-PC-ArmCmd"){
  field(DESC, "Arm position compare")
  field(DTYP, "asynInt32")
  field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt32/ax$(AXIS_NO).poscomp.armcmd?")
  field(ZNAM, "Idle")
  field(ONAM, "Arm")
  field(SCAN, "Passive")
  field(HIGH, "0.1")
}

record(bo,"${P}${AXIS_NAME}-PC-CancelCmd"){
  field(DESC, "Cancel position compare")
  field(DTYP, "asynInt32")
  field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt32/ax$(AXIS_NO).poscomp.cancelcmd?")
  field(ZNAM, "Idle")
  field(ONAM, "Cancel")
  field(SCAN, "Passive")
  field(HIGH, "0.1")
}
