          { Busy, plc0.static.busy }
          { Homed, plc0.static.homed }
          { Actual, plc0.static.actual }
          { Enabled, plc0.static.enabled }
          { AtTarget, plc0.static.atTarget }
          { AxisError, plc0.static.axisError }
          { LastTarget, global.lastTarget }
          { EcValue, plc0.static.ecValue }
