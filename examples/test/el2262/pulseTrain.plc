# CH1 has eight output samples per packed byte and a 1 kHz bus clock.
# Advance phase once per output bit and preserve it across EtherCAT cycles.
var frequency := static.frequencyHz;
var packed := 0;
var mask := 1;
var sample := 0;
var byteIndex := 0;
var sampleRate := 8000 * ${PULSE_BYTES=1};
var phaseStep := frequency / sampleRate;

for (byteIndex := 0; byteIndex < ${PULSE_BYTES=1}; byteIndex += 1)
{
  packed := 0;
  mask := 1;
  if (frequency > 0 and frequency <= sampleRate / 2)
  {
    for (sample := 0; sample < 8; sample += 1)
    {
      if (static.phase < 0.5)
      {
        packed += mask;
      };
      mask *= 2;
      static.phase += phaseStep;
      static.phase -= floor(static.phase);
    };
  }
  else
  {
    static.phase := 0;
  };

  # CH1 is memmap 0 in both standalone IOCs.
  ec_set_mm_data(0, byteIndex, packed);
};

# Update the 16-bit cycle counter once per EtherCAT cycle.
static.counter += 1;
if (static.counter >= 65536)
{
  static.counter := 0;
};
ec0.s23.cycleCounter01 := static.counter;
