# Motor-record soft limits only; ECMC soft limits are disabled after loading.
require ecmccfg v11.2.0_RC1 "ENG_MODE=1,MASTER_ID=0,ECMC_VER=v11.2.0_RC1"
epicsEnvSet(ECMC_STARTUP_GATE,1)

${SCRIPTEXEC} ${ecmccfg_DIR}addSlave.cmd, "SLAVE_ID=${DRV_SID=14},HW_DESC=EL7041-0052"
${SCRIPTEXEC} ${ecmccfg_DIR}applyComponent.cmd "COMP=Motor-Generic-2Phase-Stepper,MACROS='I_MAX_MA=1000,I_STDBY_MA=200,U_NOM_MV=48000,R_COIL_MOHM=1230,SPEED_RANGE=2'"
epicsEnvSet(DRV_SID,${ECMC_EC_SLAVE_NUM})
${SCRIPTEXEC} ${ecmccfg_DIR}loadYamlAxis.cmd, "FILE=./cfg/axis.yaml,DEV=${IOC},AX_NAME=M1,AXIS_ID=4,DRV_SID=${DRV_SID},ENC_SID=${DRV_SID},ENC_CH=01"
